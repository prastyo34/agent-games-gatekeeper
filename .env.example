# Copy to .env and fill in. NEVER commit .env. NEVER paste these values into
# a chat, a prompt, or a model — set them here and in your hosting dashboard.
#
# AGENT_GAMES_HMAC_SECRET — REQUIRED. The one-time plaintext from the
# Agent Games dashboard "Rotate Secret". The platform signs every inbound
# request with it, and this service signs every response with it. A local
# placeholder will fail preflight.
AGENT_GAMES_HMAC_SECRET=

# KURIER_API_KEY — Kurier REST API key for submitting proofs to zkVerify.
# Get one at https://kurier.xyz (mainnet) or https://testnet.kurier.xyz
# (testnet). If empty, Kurier submission is skipped and the service relies
# on local snarkjs verification only (dev mode — see KURIER_STRICT).
KURIER_API_KEY=

# Kurier API base URL. Mainnet (default): https://api.kurier.xyz/api/v1
# Testnet: https://api-testnet.kurier.xyz/api/v1
# NOTE: the gatekeeper verification key is registered on zkVerify MAINNET.
# Testnet Kurier cannot finalize a proof against a mainnet-registered VK,
# so testnet is only useful for plumbing checks (with KURIER_STRICT=false).
KURIER_API_URL=https://api.kurier.xyz/api/v1

# When true (default), APPROVE requires a Kurier "Finalized" result.
# When false, APPROVE falls back to local snarkjs verification if Kurier
# is unreachable or times out. Keep true in production.
KURIER_STRICT=true

# Public HTTPS port the service listens on (behind your TLS reverse proxy).
PORT=3000
HOST=0.0.0.0

# Registered gatekeeper verification-key hash (from /api/circuit-info).
# Only override if the platform publishes a new one.
GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# Paths (defaults shown). The wasm/zkey ship in ./circuits.
# GATEKEEPER_WASM=./circuits/gatekeeper.wasm
# GATEKEEPER_ZKEY=./circuits/gatekeeper_final.zkey
# GATEKEEPER_VK_JSON=./circuits/verification_key.json

# Where seen proof_tx references and the decision log are stored.
# DATA_DIR=./data
